  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f161123988b7474c9f5a46963c1fdf3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ShipAIPanel
  lines:
  - speakerName: Ship AI
    subtitle: "Hel--lo, space caDet. It see--ms you are the remai--ning survivor
      on this ship\u2026 though my records are incomp--lete. I cannot deterMine wHetHer
      the others esca--ped\u2026 or if they are no longer al--ive. PoWeR sys--tems
      are currently off--line. You will need to loCa--te the engine room\u2026 and
      resto--re power. Please proc--eed with cau--tion.--caution--signal integ--rity
      unstable--"
    voiceClip: {fileID: 0}
    typingSFX: {fileID: 0}
    baseTypeSpeed: 0.05
    speedMultiplier: 1
    overrideTyping: 0
    overrideTypeSpeed: 0.05
    fallbackDuration: 0
    nextIndex: 0
    requiredItem: {fileID: 0}
    consumeItem: 0
    useTimerGate: 0
    triggerBeforeTime: 0
    choices:
    - choiceText: Where am I?
      nextIndex: 1
    - choiceText: What happened?
      nextIndex: 2
  - speakerName: Ship AI
    subtitle: "Even I am un--sure. I beli--eve my sys--tem\u2019s mEm--ory was part--ially
      dest--royed due to whate--ver hAppened not too long Ag--o\u2026 Unfortu--nately,
      I can\u2019t seem to remEm--ber\u2014much like y--ou. It see--ms you h--it
      your head, trigg--ering amne--sia."
    voiceClip: {fileID: 0}
    typingSFX: {fileID: 0}
    baseTypeSpeed: 0.05
    speedMultiplier: 1
    overrideTyping: 0
    overrideTypeSpeed: 0.05
    fallbackDuration: 0
    nextIndex: 3
    requiredItem: {fileID: 0}
    consumeItem: 0
    useTimerGate: 0
    triggerBeforeTime: 0
    choices: []
  - speakerName: Ship AI
    subtitle: "My g--uess is so--me kinD of exLl--osion\u2026 I beli--eve that wOuld
      be a more hop--eful outc--ome than someth--ing moRe eer--ie in this infi--nitely
      black univ--erse\u2026 like an alien perh--aPs? Hop--efully this turns out
      to be more like Inte--rstellar\u2026"
    voiceClip: {fileID: 0}
    typingSFX: {fileID: 0}
    baseTypeSpeed: 0.05
    speedMultiplier: 1
    overrideTyping: 0
    overrideTypeSpeed: 0.05
    fallbackDuration: 0
    nextIndex: 3
    requiredItem: {fileID: 0}
    consumeItem: 0
    useTimerGate: 0
    triggerBeforeTime: 0
    choices: []
  - speakerName: Ship AI
    subtitle: '&^*#(%#&(%^&@^(&@$^(&$@8761%&5^476$5364#$#$%@^%&(Q78%^%674^&------ '
    voiceClip: {fileID: 0}
    typingSFX: {fileID: 0}
    baseTypeSpeed: 0.05
    speedMultiplier: 1
    overrideTyping: 0
    overrideTypeSpeed: 0.05
    fallbackDuration: 0
    nextIndex: 4
    requiredItem: {fileID: 0}
    consumeItem: 0
    useTimerGate: 0
    triggerBeforeTime: 0
    choices: []
  - speakerName: Ship AI
    subtitle: "Excuse me\u2013 It seems my systems are still slightly fried. "
    voiceClip: {fileID: 0}
    typingSFX: {fileID: 0}
    baseTypeSpeed: 0.05
    speedMultiplier: 1
    overrideTyping: 0
    overrideTypeSpeed: 0.05
    fallbackDuration: 0
    nextIndex: 5
    requiredItem: {fileID: 0}
    consumeItem: 0
    useTimerGate: 0
    triggerBeforeTime: 0
    choices: []
  - speakerName: Ship AI
    subtitle: "I sUggest you se@rch for the engine room. If you press \u201CM\u201D
      it opens up your map. It shOuld be located through the Main_Gate, into the
      Core_Ring, where you can find an end!ess loop of doorways\u2026 Good luck.
      Interact with my d!gital screen in each room to communicate with me once ag@in."
    voiceClip: {fileID: 0}
    typingSFX: {fileID: 0}
    baseTypeSpeed: 0.05
    speedMultiplier: 1
    overrideTyping: 0
    overrideTypeSpeed: 0.05
    fallbackDuration: 0
    nextIndex: 6
    requiredItem: {fileID: 0}
    consumeItem: 0
    useTimerGate: 0
    triggerBeforeTime: 0
    choices: []
  shipAI: {fileID: 1446279514}
